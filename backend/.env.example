# Copy this file to .env and fill in local values. Never commit .env.
PORT=8000
NODE_ENV=development
TZ=Asia/Kolkata

# Comma-separated origins. Only NODE_ENV=development accepts any origin;
# staging and production must list their origins here.
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Either set DATABASE_URL (mysql://...) or the discrete DB_* variables.
DATABASE_URL=
DB_DIALECT=mysql
DB_HOST=localhost
DB_PORT=3307
DB_NAME=dairy_db
DB_USER=root
DB_PASSWORD=change-me
DB_LOGGING=false
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=0
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800

# Request body cap and password hashing cost.
BODY_LIMIT_BYTES=1048576
BCRYPT_ROUNDS=10

# Security audit. Set TRUST_PROXY=true only when a trusted reverse proxy
# overwrites X-Forwarded-For; otherwise clients could spoof their IP address.
TRUST_PROXY=false
AUDIT_RETENTION_DAYS=365

# Failed-login protection for staff and customer portal accounts alike.
# Failures older than LOGIN_LOCKOUT_WINDOW_MINUTES do not count towards a burst.
# The moment a burst reaches LOGIN_COOLDOWN_THRESHOLD (5 wrong passwords) the
# owner is emailed and sign-in is paused for LOGIN_COOLDOWN_MINUTES (5 minutes).
# The pause is measured from that threshold attempt, so it always lasts the full
# duration, and it is stored in the database: closing the tab, reloading the page
# or restarting the API does not shorten it. Attempts made during the pause are
# refused with 429 and are not counted, so repeating them cannot lock the
# account. When a burst reaches LOGIN_LOCKOUT_THRESHOLD (10 wrong passwords)
# the account is locked: is_active becomes false, every session is revoked, and
# only an administrator can unlock it from the Users or Portal Accounts page.
# That lock has no timer and never expires on its own. Every unlock is written
# to the security audit ledger.
#
# LOGIN_LOCKOUT_WINDOW_MINUTES (15) is only the counting window: how far back a
# burst of failures is measured. It never expires a lock.
#
# The 5/15-minute pause text shown on the login pages is built from these two
# values (LOGIN_COOLDOWN_MINUTES and LOGIN_COOLDOWN_THRESHOLD) at request time:
# change them here and restart the API, and every error message, countdown and
# alert email follows automatically. No frontend or backend code change needed.
FAILED_LOGIN_ALERT_ENABLED=true
FAILED_LOGIN_ALERT_THRESHOLD=5
# Alert window: how far back the failed-login email counts attempts.
FAILED_LOGIN_ALERT_WINDOW_MINUTES=15
FAILED_LOGIN_ALERT_COOLDOWN_MINUTES=15
LOGIN_COOLDOWN_THRESHOLD=5
LOGIN_COOLDOWN_MINUTES=5
LOGIN_LOCKOUT_THRESHOLD=10
LOGIN_LOCKOUT_WINDOW_MINUTES=15

# Access token lives in frontend memory; refresh token lives in an httpOnly cookie.
# NODE_ENV=production refuses to start unless JWT_SECRET and
# CUSTOMER_JWT_SECRET are distinct private values of 32+ characters and
# ADMIN_PASSWORD is no longer the shipped default.
JWT_SECRET=change-me-to-at-least-32-random-characters
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_MINUTES=480

# Refresh cookie attributes. Leave SECURE empty to auto-enable it in production.
# The path must cover every guarded route, because each request is checked for
# this cookie; a narrower value (e.g. /api/v1/auth) is widened to the API prefix
# at startup so it cannot lock the API.
REFRESH_COOKIE_NAME=dairy_refresh_token
REFRESH_COOKIE_PATH=/api/v1
REFRESH_COOKIE_DOMAIN=
REFRESH_COOKIE_SAMESITE=lax
REFRESH_COOKIE_SECURE=

# Non-httpOnly flag cookie the SPA reads to avoid probing /auth/refresh when
# nobody is signed in. It never contains a token.
SESSION_HINT_COOKIE_NAME=dairy_session

ADMIN_NAME=System Admin
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@dairyfarm.com
ADMIN_PASSWORD=change-me

# Customer portal. Leave CUSTOMER_JWT_SECRET empty locally to reuse JWT_SECRET.
# Production requires its own 32+ character value so staff and customer tokens
# cannot be mixed up.
CUSTOMER_JWT_SECRET=
CUSTOMER_ACTIVATION_TTL_HOURS=72
CUSTOMER_REFRESH_COOKIE_NAME=dairy_customer_refresh_token
CUSTOMER_SESSION_HINT_COOKIE_NAME=dairy_customer_session
CUSTOMER_ORDER_MIN_LITRES=1.00
CUSTOMER_ORDER_MAX_LITRES=500.00
CUSTOMER_ORDER_DAILY_CAP_LITRES=500.00
CUSTOMER_ORDER_WINDOW_DAYS=14

# Transactional email (password resets, portal activation links).
# Defaults below target a local Mailpit server: SMTP on 127.0.0.1:1025, web UI
# on http://127.0.0.1:8025, with no authentication and no TLS.
# Mailpit only accepts mail for any address; view it in the web UI.
# For a hosted provider use its host, e.g. SMTP_PORT=587 + SMTP_USE_TLS=true,
# or SMTP_PORT=465 + SMTP_USE_SSL=true. Enable only one of TLS/SSL.
# Leave SMTP_HOST empty to skip sending: the message and its link are logged
# instead. Use 127.0.0.1 for a server on this machine ('mailpit' only resolves
# inside that Docker container's network). Outside production, 127.0.0.1:1025
# is treated as Mailpit's plain listener, so stale TLS/auth values are ignored.
FRONTEND_URL=http://localhost:5173
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_USE_TLS=false
SMTP_USE_SSL=false
SMTP_TIMEOUT_SECONDS=10
MAIL_FROM_EMAIL=no-reply@dairyfarm.com
MAIL_FROM_NAME=AmritDhara Dairy

# Encryption key for SMTP credentials stored by the Admin UI. Generate one with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Keep it outside the database and source control. Losing the key makes stored
# credentials unreadable; an Admin must re-enter them. Set the previous key only
# while rotating: new writes use the primary key, old ciphertext stays readable.
# Nothing re-encrypts automatically, so to retire the previous key, edit each
# SMTP profile that has credentials and enter them again (the API never returns
# a stored secret), then remove EMAIL_SETTINGS_ENCRYPTION_KEY_PREVIOUS.
# Both values must be Fernet keys (44-character urlsafe base64).
EMAIL_SETTINGS_ENCRYPTION_KEY=
EMAIL_SETTINGS_ENCRYPTION_KEY_PREVIOUS=

# Password reset links stay valid for this many minutes and are single-use.
PASSWORD_RESET_TTL_MINUTES=30
