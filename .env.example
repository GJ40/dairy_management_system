# Copy this file to .env and fill in local values. Never commit .env.
PORT=8000
NODE_ENV=development
TZ=Asia/Kolkata

# Comma-separated origins. Only NODE_ENV=development accepts any origin;
# staging and production must list their origins here.
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Either set DATABASE_URL (mysql://...) or the discrete DB_* variables.
DATABASE_URL=
DB_DIALECT=mysql
DB_HOST=localhost
DB_PORT=3307
DB_NAME=dairy_db
DB_USER=root
DB_PASSWORD=change-me
DB_LOGGING=false
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=0
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800

# Request body cap and password hashing cost.
BODY_LIMIT_BYTES=1048576
BCRYPT_ROUNDS=10

# Access token lives in frontend memory; refresh token lives in an httpOnly cookie.
# NODE_ENV=production refuses to start unless JWT_SECRET and
# CUSTOMER_JWT_SECRET are distinct private values of 32+ characters and
# ADMIN_PASSWORD is no longer the shipped default.
JWT_SECRET=change-me-to-at-least-32-random-characters
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_MINUTES=480

# Refresh cookie attributes. Leave SECURE empty to auto-enable it in production.
# The path must cover every guarded route, because each request is checked for
# this cookie; a narrower value (e.g. /api/v1/auth) is widened to the API prefix
# at startup so it cannot lock the API.
REFRESH_COOKIE_NAME=dairy_refresh_token
REFRESH_COOKIE_PATH=/api/v1
REFRESH_COOKIE_DOMAIN=
REFRESH_COOKIE_SAMESITE=lax
REFRESH_COOKIE_SECURE=

# Non-httpOnly flag cookie the SPA reads to avoid probing /auth/refresh when
# nobody is signed in. It never contains a token.
SESSION_HINT_COOKIE_NAME=dairy_session

ADMIN_NAME=System Admin
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@dairyfarm.com
ADMIN_PASSWORD=change-me

# Customer portal. Leave CUSTOMER_JWT_SECRET empty locally to reuse JWT_SECRET.
# Production requires its own 32+ character value so staff and customer tokens
# cannot be mixed up.
CUSTOMER_JWT_SECRET=
CUSTOMER_ACTIVATION_TTL_HOURS=72
CUSTOMER_REFRESH_COOKIE_NAME=dairy_customer_refresh_token
CUSTOMER_SESSION_HINT_COOKIE_NAME=dairy_customer_session
CUSTOMER_ORDER_MIN_LITRES=1.00
CUSTOMER_ORDER_MAX_LITRES=500.00
CUSTOMER_ORDER_DAILY_CAP_LITRES=500.00
CUSTOMER_ORDER_WINDOW_DAYS=14

# Transactional email (password resets, portal activation links).
# Defaults below target a local Mailpit server: SMTP on 127.0.0.1:1025, web UI
# on http://127.0.0.1:8025, with no authentication and no TLS.
# Mailpit only accepts mail for any address; view it in the web UI.
# For a hosted provider use its host, e.g. SMTP_PORT=587 + SMTP_USE_TLS=true,
# or SMTP_PORT=465 + SMTP_USE_SSL=true. Enable only one of TLS/SSL.
# Leave SMTP_HOST empty to skip sending: the message and its link are logged
# instead. Use 127.0.0.1 for a server on this machine ('mailpit' only resolves
# inside that Docker container's network). Outside production, 127.0.0.1:1025
# is treated as Mailpit's plain listener, so stale TLS/auth values are ignored.
FRONTEND_URL=http://localhost:5173
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_USE_TLS=false
SMTP_USE_SSL=false
SMTP_TIMEOUT_SECONDS=10
MAIL_FROM_EMAIL=no-reply@dairyfarm.com
MAIL_FROM_NAME=AmritDhara Dairy

# Password reset links stay valid for this many minutes and are single-use.
PASSWORD_RESET_TTL_MINUTES=30
