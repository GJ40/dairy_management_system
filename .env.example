# Copy this file to .env and fill in local values. Never commit .env.
PORT=8000
NODE_ENV=development
TZ=Asia/Kolkata

# Comma-separated origins. In non-production the API allows all origins.
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Either set DATABASE_URL (mysql://...) or the discrete DB_* variables.
DATABASE_URL=
DB_DIALECT=mysql
DB_HOST=localhost
DB_PORT=3307
DB_NAME=dairy_db
DB_USER=root
DB_PASSWORD=change-me
DB_LOGGING=false

JWT_SECRET=change-me-to-at-least-32-random-characters
JWT_EXPIRE_MINUTES=480

ADMIN_NAME=System Admin
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@dairyfarm.com
ADMIN_PASSWORD=change-me
