# ==============================================================================
# Dairy Management System — Docker Compose Environment Variables
# Copy this file to .env before starting Docker Compose:
#   cp .env.example .env
# ==============================================================================

# Database Configuration
DB_NAME=dairy_db
DB_USER=root
DB_PASSWORD=root
DB_ROOT_PASSWORD=root
# Host port published for MySQL. MySQL always listens on 3306 inside Docker.
# Change this if 3306 is already in use (e.g. 3308).
DB_PORT=3306
DB_LOGGING=false

# Backend Port Mapping
BACKEND_PORT=8000

# Frontend Port Mapping
FRONTEND_PORT=5173

# Frontend API Base URL (relative `/api/v1` proxies via Nginx to backend)
VITE_API_BASE_URL=/api/v1

# Security & Secret Keys (Replace with strong random strings in production)
JWT_SECRET=change-me-to-at-least-32-random-characters
CUSTOMER_JWT_SECRET=change-me-to-at-least-32-customer-characters
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_MINUTES=480

# Bootstrap Admin User Credentials
ADMIN_NAME=System Admin
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@dairyfarm.com
ADMIN_PASSWORD=AdminSecurePass123

# Customer Portal Limits
CUSTOMER_ACTIVATION_TTL_HOURS=72
CUSTOMER_ORDER_MIN_LITRES=1.00
CUSTOMER_ORDER_MAX_LITRES=500.00
CUSTOMER_ORDER_DAILY_CAP_LITRES=500.00
CUSTOMER_ORDER_WINDOW_DAYS=14

# SMTP / Email Configuration (Leave SMTP_HOST empty to disable sending and log to console)
FRONTEND_URL=http://localhost:5173
SMTP_HOST=
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_USE_TLS=false

